					AND QG6dosyx_posts.post_type IN ( 'product' )
					AND ( ( 
			( SELECT COUNT(element_id)
			  FROM QG6dosyx_icl_translations
			  WHERE trid = wpml_translations.trid
			  AND language_code = 'en'
			) = 0
			 ) OR ( 
			( SELECT COUNT(element_id)
				FROM QG6dosyx_icl_translations t2
				JOIN QG6dosyx_posts p ON p.id = t2.element_id
				WHERE t2.trid = wpml_translations.trid
				AND t2.language_code = 'en'
                AND (
                    p.post_status = 'publish' OR p.post_status = 'private' OR 
                    ( p.post_type='attachment' AND p.post_status = 'inherit' )
                )
			) = 0 ) ) 
				) ) AND QG6dosyx_posts.post_type  IN ('post','page','attachment','wp_block','wp_template','wp_template_part','wp_navigation','product','product_variation','wpcf7_contact_form','yith_wcan_preset' )  ) OR QG6dosyx_posts.post_type  NOT  IN ('post','page','attachment','wp_block','wp_template','wp_template_part','wp_navigation','product','product_variation','wpcf7_contact_form','yith_wcan_preset' )  )
					 
					 ORDER BY QG6dosyx_posts.post_date DESC
					 
